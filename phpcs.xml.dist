<?xml version="1.0"?>
<ruleset name="BLT Activity Log">
	<description>WordPress coding standards for BLT Activity Log.</description>

	<file>.</file>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/tests/*</exclude-pattern>
	<exclude-pattern>*/includes/lib/*</exclude-pattern>
	<!--
		Vendored byte-identical into every BLT plugin, so it is not ours to
		restyle here: it uses the shared 'blt-family' text domain and
		BLT_Family_* prefixes, neither of which this ruleset whitelists.
	-->
	<exclude-pattern>*/includes/blt-family/*</exclude-pattern>
	<exclude-pattern>*/blt-family-smoke.php</exclude-pattern>
	<exclude-pattern>*/.github/*</exclude-pattern>
	<exclude-pattern>*/bin/*</exclude-pattern>

	<arg value="ps"/>
	<arg name="extensions" value="php"/>
	<arg name="parallel" value="4"/>

	<config name="minimum_wp_version" value="6.0"/>
	<config name="testVersion" value="7.4-"/>

	<rule ref="WordPress-Extra">
		<!-- Short array syntax is fine; we target PHP 7.4+. -->
		<exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
		<!-- Directory context already namespaces our files (includes/class-blt-activity-log-module-posts.php). -->
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
	</rule>

	<!-- The floor is PHP 7.4: nothing newer may creep in. -->
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="blt-activity-log"/>
			</property>
		</properties>
	</rule>

	<!--
		Views are included from inside controller methods, so their variables are
		local to the method, not globals. The sniff cannot tell, so it is switched
		off for this one error code in this one folder.
	-->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedVariableFound">
		<exclude-pattern>*/admin/views/*</exclude-pattern>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="blt_activity_log"/>
				<element value="BLT_Activity_Log"/>
				<element value="BLT_ACTIVITY_LOG"/>
			</property>
		</properties>
	</rule>
</ruleset>
